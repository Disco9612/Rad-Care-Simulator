  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "[\uC784\uBB34] \uD658\uC790 \uC774\uC1A1 \uC644\uB8CC.\n\uCE21\uC815\uAE30\uB85C
    \uC624\uC5FC \uBD80\uC704\uB97C \uD655\uC778\uD55C \uB4A4 \uC81C\uC5FC \uC791\uC5C5\uC744
    \uC9C4\uD589\uD558\uC2ED\uC2DC\uC624.\n\n\uC624\uB978\uCABD \uCEE8\uD2B8\uB864\uB7EC
    A \uBC84\uD2BC: \uC784\uBB34 \uC2DC\uC791\n\uD2B8\uB9AC\uAC70 \uD55C \uBC88:
    \uAC00\uAE4C\uC6B4 \uB3C4\uAD6C \uC7A1\uAE30 (\uBC84\uD2BC\uC744 \uB193\uC544\uB3C4
    \uC720\uC9C0)\n\uC67C\uCABD \uC2A4\uD2F1: \uC774\uB3D9\n\uB3C4\uAD6C\uB97C \uD658\uC790\uC5D0\uAC8C
    \uC811\uCD09\uD558\uC5EC \uC0AC\uC6A9\uD558\uACE0, \uD45C\uC2DC\uB41C \uBC18\uB0A9
    \uC704\uCE58\uC5D0 \uB193\uC73C\uBA74 \uC790\uB3D9\uC73C\uB85C \uBD84\uB9AC\uB429\uB2C8\uB2E4."
